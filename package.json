{
  "name": "harvest-jam",
  "version": "2.0.0",
  "private": true,
  "description": "Harvest JAM: sistema de gestión para fruterías (Node.js + React + PostgreSQL)",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "db:setup": "npm run db:setup --workspace server --"
  }
}
