# Copia este archivo como .env y ajusta los valores.

# --- PostgreSQL ---------------------------------------------------------
# Cada persona entra con su propio usuario de PostgreSQL (ver base-de-datos/04_roles.sql).
PGHOST=localhost
PGPORT=5432
PGDATABASE=TBD

# Solo para "npm run db:setup" (crear la base y cargar los scripts).
PGADMIN_USER=postgres
PGADMIN_PASSWORD=postgres

# --- Servidor -----------------------------------------------------------
PORT=3001
# Horas sin actividad para que una sesión se cierre sola.
SESION_HORAS=8
# Existencia a partir de la cual un producto se marca como "bajo".
UMBRAL_STOCK_BAJO=10

# --- Datos del ticket ---------------------------------------------------
EMPRESA_NOMBRE=Harvest JAM
EMPRESA_SUBTITULO=Frutas y verduras
EMPRESA_TELEFONO=
EMPRESA_DIRECCION=
EMPRESA_MENSAJE_TICKET=¡Gracias por su compra! Vuelva pronto.
